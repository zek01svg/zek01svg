{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "main": "src/server.ts",
  "vars": {
    "STRAPI_URL": "https://strapi.ciav.dev",
  },
  "routes": [
    {
      "pattern": "ciav.dev",
      "custom_domain": true,
    },
  ],
}
